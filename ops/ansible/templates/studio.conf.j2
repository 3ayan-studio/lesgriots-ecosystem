# ===========================================
# Nginx — Studio (Production + Staging)
# ===========================================
# Managed by Ansible. Do not edit manually on the VPS.

# --- PRODUCTION STUDIO ---
server {
    listen 80;
    server_name studio.{{ domain }};

    root {{ base_dir }}/production/current/studio/dist;
    index index.html;

    include /etc/nginx/mime.types;
    types {
        application/javascript mjs;
    }

    location / {
        # SPA Fallback
        try_files $uri $uri/ /index.html;
    }
}

# --- STAGING STUDIO ---
server {
    listen 80;
    server_name staging.studio.{{ domain }};

    root {{ base_dir }}/staging/current/studio/dist;
    index index.html;

    include /etc/nginx/mime.types;
    types {
        application/javascript mjs;
    }

    location / {
        # SPA Fallback
        try_files $uri $uri/ /index.html;
    }
}
